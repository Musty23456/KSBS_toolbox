# --- Database ---
# Production/dev Postgres connection string.
# Example: postgresql+psycopg2://kbs_user:change_me@localhost:5432/kbs_toolbox
DATABASE_URL=postgresql+psycopg2://kbs_user:change_me@localhost:5432/kbs_toolbox

# For local testing without Postgres installed, you can instead use SQLite:
# DATABASE_URL=sqlite:///./kbs_toolbox.db

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- App ---
APP_ENV=development
APP_NAME=KBS Toolbox API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Seed / demo ---
SEED_DEMO_DATA=true
DEMO_ADMIN_EMAIL=admin@kbstoolbox.local
DEMO_ADMIN_PASSWORD=ChangeMe123!

# --- AI integration (Google Gemini) ---
# AI is OFF by default. To enable: get a key at https://aistudio.google.com/apikey,
# put it below in YOUR LOCAL .env (never commit it), and set AI_ENABLED=true.
# The key stays on the server; it is never sent to the web or Android apps.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Seconds to wait for one AI call (1-120) and retries for transient errors (0-5).
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=2
# Per-user limit on AI endpoints (requests per minute).
AI_RATE_LIMIT_PER_MINUTE=10
# Max request body (bytes) and max prompt length (characters) for AI endpoints.
AI_MAX_REQUEST_BYTES=16384
AI_MAX_PROMPT_CHARS=8000

# --- AI questionnaire generator (Phase 2) ---
# A whole questionnaire is a long answer, so it has its own, larger limits.
# Seconds per Gemini call for generation (1-300). If your host cuts requests off
# earlier (many proxies stop at 60-100 s), lower this or ask for fewer questions.
AI_GENERATION_TIMEOUT=90
AI_GENERATION_MAX_REQUEST_BYTES=65536
AI_GENERATION_MAX_PROMPT_CHARS=30000
# Output-token ceiling for one generation (Gemini 2.5 models count their internal
# "thinking" tokens in this budget too). Most questionnaires need far less.
AI_GENERATION_MAX_OUTPUT_TOKENS=32768
# Most questions a user may request in one go.
AI_GENERATION_MAX_QUESTIONS=100

# --- AI questionnaire editor (Phase 3) ---
# Largest request body (bytes) for the editor: it carries the whole questionnaire open in the builder.
AI_EDIT_MAX_REQUEST_BYTES=262144
